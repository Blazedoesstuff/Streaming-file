# YouTube
YOUTUBE_ENABLED=true
YOUTUBE_URL=rtmps://YOUR_YOUTUBE_SERVER
YOUTUBE_KEY=YOUR_YOUTUBE_STREAM_KEY

# Twitch
TWITCH_ENABLED=true
TWITCH_URL=rtmp://ingest.global-contribute.live-video.net/app
TWITCH_KEY=YOUR_TWITCH_STREAM_KEY
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret
TWITCH_REDIRECT_URI=http://localhost:8000/accounts/twitch/callback

# Facebook
FACEBOOK_ENABLED=true
FACEBOOK_URL=rtmps://YOUR_FACEBOOK_SERVER
FACEBOOK_KEY=YOUR_FACEBOOK_STREAM_KEY

# TikTok
TIKTOK_ENABLED=false
TIKTOK_URL=YOUR_TIKTOK_SERVER
TIKTOK_KEY=YOUR_TIKTOK_STREAM_KEY

# Kick
KICK_ENABLED=false
KICK_URL=YOUR_KICK_SERVER
KICK_KEY=YOUR_KICK_STREAM_KEY

# google
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/accounts/youtube/callback

# Any additional platform
CUSTOM_ENABLED=false
CUSTOM_URL=YOUR_CUSTOM_RTMP_SERVER
CUSTOM_KEY=YOUR_CUSTOM_STREAM_KEY

JWT_SECRET=your-super-secret-key-change-this
